{
  "name": "@desktop/desktop",
  "productName": "Desktop Starter",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Electron desktop starter",
  "homepage": "https://example.com",
  "author": "Template Author",
  "license": "MIT",
  "desktopName": "desktop-starter.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:e2e",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir --config electron-builder.config.mjs",
    "build:win": "pnpm build && electron-builder --win --config electron-builder.config.mjs",
    "build:linux": "pnpm build && electron-builder --linux --config electron-builder.config.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@desktop/shared": "workspace:*",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
